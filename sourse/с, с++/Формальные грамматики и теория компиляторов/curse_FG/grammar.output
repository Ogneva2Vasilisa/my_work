Grammar

    0 $accept: program $end

    1 program: function_definition
    2        | main_function
    3        | struct_declaration
    4        | union_declaration
    5        | enum_declaration
    6        | declaration semicolons
    7        | union_variable_declaration semicolons
    8        | program function_definition
    9        | program main_function
   10        | program struct_declaration
   11        | program union_declaration
   12        | program enum_declaration
   13        | program declaration semicolons
   14        | program union_variable_declaration semicolons

   15 function_definition: type IDENTIFIER LPAREN parameter_list RPAREN compound_statement
   16                    | type point IDENTIFIER LPAREN parameter_list RPAREN compound_statement
   17                    | type IDENTIFIER LPAREN parameter_list RPAREN semicolons
   18                    | type IDENTIFIER LPAREN RPAREN semicolons
   19                    | type declarator compound_statement
   20                    | type declarator semicolons

   21 point: MULTIPLY
   22      | point point

   23 main_function: type IDENTIFIER LPAREN RPAREN compound_statement

   24 struct_declaration: STRUCT IDENTIFIER SEMICOLON
   25                   | STRUCT IDENTIFIER LBRACE struct_member_list RBRACE semicolons
   26                   | STRUCT IDENTIFIER LBRACE struct_member_list RBRACE IDENTIFIER semicolons

   27 union_declaration: UNION IDENTIFIER LBRACE struct_member_list RBRACE semicolons
   28                  | UNION IDENTIFIER LBRACE struct_member_list RBRACE IDENTIFIER semicolons
   29                  | UNION LBRACE struct_member_list RBRACE semicolons
   30                  | UNION LBRACE struct_member_list RBRACE IDENTIFIER semicolons

   31 union_variable_declaration: UNION IDENTIFIER union_declarator_list

   32 union_declarator_list: union_declarator
   33                      | union_declarator_list COMMA union_declarator

   34 union_declarator: IDENTIFIER
   35                 | MULTIPLY IDENTIFIER
   36                 | MULTIPLY MULTIPLY IDENTIFIER

   37 enum_declaration: ENUM IDENTIFIER LBRACE enum_list_nonempty RBRACE semicolons
   38                 | ENUM IDENTIFIER LBRACE enum_list_nonempty RBRACE IDENTIFIER semicolons
   39                 | ENUM LBRACE enum_list_nonempty RBRACE semicolons
   40                 | ENUM LBRACE enum_list_nonempty RBRACE IDENTIFIER semicolons

   41 enum_list_nonempty: enum_item
   42                   | enum_list_nonempty COMMA enum_item

   43 enum_item: IDENTIFIER
   44          | IDENTIFIER ASSIGN constant_expression

   45 struct_member_list: struct_member
   46                   | struct_member struct_member_list

   47 struct_member: type declarator semicolons
   48              | type init_declarator_list semicolons
   49              | type bitfield_list semicolons
   50              | struct_declaration
   51              | union_declaration

   52 bitfield_list: bitfield_with_decl
   53              | bitfield_list COMMA bitfield_with_decl
   54              | bitfield_without_decl
   55              | bitfield_list COMMA bitfield_without_decl

   56 bitfield_with_decl: declarator COLON constant_expression

   57 bitfield_without_decl: COLON constant_expression

   58 type: cast_type
   59     | STATIC type
   60     | type TYPE

   61 cast_type: TYPE
   62          | TYPE pointer
   63          | TYPE pointer_opt
   64          | STRUCT IDENTIFIER pointer_opt
   65          | UNION IDENTIFIER pointer_opt
   66          | ENUM IDENTIFIER pointer_opt
   67          | IDENTIFIER pointer_opt
   68          | LONG TYPE pointer_opt
   69          | SHORT TYPE pointer_opt
   70          | FILE_TYPE pointer_opt
   71          | LONG pointer_opt
   72          | SHORT pointer_opt
   73          | UNSIGNED opt_type pointer_opt
   74          | SIGNED opt_type pointer_opt
   75          | LONG_LONG pointer_opt
   76          | UNSIGNED_LONG_LONG pointer_opt
   77          | SIGNED_LONG_LONG pointer_opt
   78          | UNSIGNED_SHORT pointer_opt
   79          | SIGNED_SHORT pointer_opt
   80          | UNSIGNED_LONG pointer_opt
   81          | SIGNED_LONG pointer_opt
   82          | UNSIGNED_TYPE pointer_opt
   83          | SIGNED_TYPE pointer_opt
   84          | LONG_DOUBLE pointer_opt
   85          | STATIC cast_type

   86 opt_type: ε
   87         | TYPE

   88 pointer_opt: ε
   89            | pointer

   90 pointer: MULTIPLY
   91        | pointer pointer

   92 amper: AMPERSAND
   93      | AMPERSAND amper

   94 parameter_list: parameter_list COMMA parameter_declaration
   95               | parameter_declaration

   96 parameter_declaration: type declarator
   97                      | type abstract_declarator
   98                      | type
   99                      | type amper declarator
  100                      | type amper abstract_declarator

  101 abstract_declarator: pointer
  102                    | pointer direct_abstract_declarator
  103                    | direct_abstract_declarator
  104                    | amper direct_abstract_declarator

  105 direct_abstract_declarator: LPAREN abstract_declarator RPAREN
  106                           | LBRACKET RBRACKET
  107                           | LBRACKET constant_expression RBRACKET
  108                           | direct_abstract_declarator LBRACKET RBRACKET
  109                           | direct_abstract_declarator LBRACKET constant_expression RBRACKET
  110                           | LPAREN RPAREN
  111                           | LPAREN parameter_list RPAREN
  112                           | direct_abstract_declarator LPAREN RPAREN
  113                           | direct_abstract_declarator LPAREN parameter_list RPAREN

  114 compound_statement: LBRACE statement_list RBRACE

  115 statement_list: statement
  116               | statement_list statement

  117 statement: IDENTIFIER COLON statement
  118          | compound_statement
  119          | if_statement
  120          | while_statement
  121          | for_statement
  122          | switch_statement
  123          | do_while_statement
  124          | statements semicolons
  125          | struct_declaration
  126          | union_declaration
  127          | enum_declaration
  128          | union_variable_declaration semicolons
  129          | semicolons

  130 statements: declaration
  131           | expression
  132           | RETURN expression
  133           | RETURN LPAREN IDENTIFIER RPAREN
  134           | RETURN
  135           | BREAK
  136           | error

  137 do_while_statement: DO statement1 WHILE LPAREN op_exp RPAREN semicolons

  138 switch_statement: SWITCH LPAREN expression RPAREN LBRACE case_list RBRACE

  139 case_list: ε
  140          | case_list case_statement
  141          | case_statement

  142 case_statement: CASE constant COLON statement_list1
  143               | CASE IDENTIFIER COLON statement_list1
  144               | DEFAULT COLON statement_list

  145 statement_list1: ε
  146                | statement
  147                | statement_list statement

  148 declaration: type init_declarator_list

  149 init_declarator_list: init_declarator
  150                     | init_declarator_list COMMA init_declarator

  151 init_declarator: declarator
  152                | point declarator
  153                | declarator ASSIGN initializer

  154 declarator: direct_declarator
  155           | pointer_opt direct_declarator
  156           | amper direct_declarator

  157 direct_declarator: IDENTIFIER
  158                  | point IDENTIFIER
  159                  | LPAREN declarator RPAREN
  160                  | direct_declarator LBRACKET RBRACKET
  161                  | direct_declarator LBRACKET constant_expression RBRACKET
  162                  | direct_declarator LPAREN RPAREN
  163                  | direct_declarator LPAREN parameter_list RPAREN

  164 constant_expression: conditional_expression

  165 designator: DOT IDENTIFIER
  166           | LBRACKET constant_expression RBRACKET

  167 designator_list: designator
  168                | designator_list designator

  169 initializer: assignment_expression
  170            | FLOAT
  171            | STRING
  172            | LBRACE initializer_list RBRACE
  173            | LBRACE initializer_list COMMA RBRACE

  174 initializer_list: ε
  175                 | initializer
  176                 | initializer_list COMMA initializer
  177                 | designator_list ASSIGN initializer
  178                 | initializer_list COMMA designator_list ASSIGN initializer

  179 expression: assignment_expression
  180           | primary_expression
  181           | expression COMMA assignment_expression

  182 assignment_expression: conditional_expression
  183                      | unary_expression ASSIGN assignment_expression
  184                      | unary_expression PLUS_ASSIGN assignment_expression
  185                      | unary_expression MINUS_ASSIGN assignment_expression
  186                      | unary_expression MULTIPLY_ASSIGN assignment_expression
  187                      | unary_expression DIVIDE_ASSIGN assignment_expression
  188                      | unary_expression MODULO_ASSIGN assignment_expression
  189                      | unary_expression LEFT_SHIFT_ASSIGN assignment_expression
  190                      | unary_expression RIGHT_SHIFT_ASSIGN assignment_expression

  191 conditional_expression: logical_or_expression

  192 logical_or_expression: inclusive_or_expression
  193                      | logical_or_expression OR logical_or_expression
  194                      | logical_or_expression AND logical_or_expression

  195 inclusive_or_expression: exclusive_or_expression
  196                        | inclusive_or_expression PIPE exclusive_or_expression
  197                        | exclusive_or_expression CARET and_expression
  198                        | and_expression AMPERSAND and_expression

  199 exclusive_or_expression: and_expression

  200 and_expression: relational_expression
  201               | and_expression EQUAL relational_expression
  202               | and_expression NEQUAL relational_expression

  203 relational_expression: shift_expression
  204                      | relational_expression LESS shift_expression
  205                      | relational_expression GREATER shift_expression
  206                      | relational_expression LE_OP shift_expression
  207                      | relational_expression GE_OP shift_expression

  208 shift_expression: additive_expression
  209                 | shift_expression LEFT_SHIFT additive_expression
  210                 | shift_expression RIGHT_SHIFT additive_expression

  211 additive_expression: multiplicative_expression
  212                    | additive_expression PLUS multiplicative_expression
  213                    | additive_expression MINUS multiplicative_expression

  214 multiplicative_expression: cast_expression
  215                          | multiplicative_expression MULTIPLY cast_expression
  216                          | multiplicative_expression DIVIDE cast_expression
  217                          | multiplicative_expression MODULO cast_expression

  218 cast_expression: unary_expression
  219                | LPAREN cast_type RPAREN cast_expression

  220 unary_expression: postfix_expression
  221                 | unary_operator unary_expression
  222                 | SIZEOF unary_expression
  223                 | SIZEOF LPAREN type RPAREN

  224 unary_operator: PLUS
  225               | MINUS
  226               | NOT
  227               | AMPERSAND
  228               | MULTIPLY
  229               | INCREMENT
  230               | DECREMENT

  231 function_call: IDENTIFIER LPAREN argument_list RPAREN

  232 postfix_expression: primary_expression
  233                   | postfix_expression LBRACKET expression RBRACKET
  234                   | postfix_expression LPAREN argument_list RPAREN
  235                   | postfix_expression DOT IDENTIFIER
  236                   | postfix_expression ARROW IDENTIFIER
  237                   | postfix_expression INCREMENT
  238                   | postfix_expression DECREMENT
  239                   | function_call

  240 primary_expression: IDENTIFIER
  241                   | constant
  242                   | STRING
  243                   | FLOAT
  244                   | LPAREN expression RPAREN
  245                   | LPAREN IDENTIFIER RPAREN

  246 constant: NUMBER
  247         | HEX_NUMBER
  248         | FLOAT
  249         | CHAR
  250         | NULLVAL
  251         | EOFVAL
  252         | TRUE_VAL
  253         | FALSE_VAL

  254 argument_list: ε
  255              | non_empty_argument_list

  256 non_empty_argument_list: expression
  257                        | non_empty_argument_list COMMA expression

  258 if_statement: IF LPAREN op_exp RPAREN statement1 if_state

  259 if_state: ε
  260         | ELSE statement1
  261         | elif1 ELSE statement1
  262         | elif1

  263 elif1: elif statement1
  264      | elif1 elif1

  265 elif: ELSE IF LPAREN op_exp RPAREN

  266 while_statement: WHILE LPAREN op_exp RPAREN statement1

  267 for_statement: FOR LPAREN for_declaration SEMICOLON op_exp SEMICOLON op_exp RPAREN statement1

  268 statement1: LBRACE RBRACE
  269           | statement

  270 op_exp: ε
  271       | expression

  272 for_declaration: ε
  273                | declaration
  274                | expression

  275 semicolons: SEMICOLON
  276           | semicolons SEMICOLON


